---
/**
 * ReconciliationStrip — the five buckets a statement row can land in after
 * upload, echoing the review screen. Used on the Statements page.
 *
 * CSS in src/styles/starlight-overrides.css (.df-buckets / .df-node).
 */
interface Props {
  summary?: string
}

const {
  summary = "Figure: each statement row lands in one of five buckets — matched (already in your ledger), ambiguous (a close match you decide), suspected duplicate (a cross-type twin to check), new (offered for import), or previously imported (from an earlier upload).",
} = Astro.props

const buckets = [
  { t: "Matched", s: "already in your ledger", accent: false },
  { t: "Ambiguous", s: "a close match — you decide", accent: false },
  { t: "Suspected duplicate", s: "a cross-type twin to check", accent: false },
  { t: "New", s: "offered for import", accent: true },
  { t: "Previously imported", s: "from an earlier upload", accent: false },
]
---

<figure class="docs-figure" aria-label={summary}>
  <div class="df-buckets">
    {
      buckets.map((b) => (
        <div class={b.accent ? "df-node df-node--accent" : "df-node"}>
          <span class="df-node__t">{b.t}</span>
          <span class="df-node__s">{b.s}</span>
        </div>
      ))
    }
  </div>
  <figcaption class="df-caption">
    Nothing is written yet — the buckets are a proposal you review row by row.
  </figcaption>
</figure>

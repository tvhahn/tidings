# AWS Credentials
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_DEFAULT_REGION=us-east-1

# OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key

# Gemini API Key — authenticates the gemini_cli AI provider as an
# alternative to its OAuth login (~/.gemini/oauth_creds.json).
# GEMINI_API_KEY=your-gemini-api-key

# Notifications — pick a provider (see docs/guides/notifications-setup.md)
#
# When NOTIFICATION_PROVIDER is unset, the service auto-detects:
#   - SNS_TOPIC_ARN set   -> sns   (existing AWS users — no change needed)
#   - NOTIFICATION_URL set -> ntfy  (self-hosters: https://ntfy.sh/your-topic)
#   - neither             -> log-only (nothing is sent; lines appear in the daemon log)
#
# NOTIFICATION_PROVIDER=ntfy

# ntfy.sh — default for self-hosters. Zero setup: pick a URL and install the app.
# NOTIFICATION_URL=https://ntfy.sh/your-unique-topic

# AWS SNS — existing AWS path. Required only if you use the Lambda stack.
# SNS_TOPIC_ARN=arn:aws:sns:us-west-2:123456789:your-topic
# AWS_REGION=us-west-2

# Twilio — cross-platform SMS. Requires a paid account + 10DLC for US numbers.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_TO_NUMBER=+15557654321

# Deployment posture (see INSTALL.md and docs/guides/agent-access.md)
# SERVE_FRONTEND=false runs headless: API only, no bundled dashboard.
# CORS_ALLOWED_ORIGINS is a comma-separated list of browser origins allowed
# to call the API; it only matters for browser-based consumers off loopback.
# Reaching the containers requires the env_file snippet in
# docker-compose.override.yml (copy the .example).
# SERVE_FRONTEND=true
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session cookie Secure attribute. Values: true, false, or auto (the default).
# auto detects it from the request scheme, so http://localhost dev stays usable
# while a TLS-fronted deployment gets Secure=True. Set true when a TLS-terminating
# reverse proxy fronts the app and the request scheme reaching it is plain http.
# AUTH_COOKIE_SECURE=auto

# Jupyter port override (default: 8888)
# JUPYTER_HOST_PORT=8888

# IMAP Polling (for self-hosted email ingestion)
# See docs/guides/self-hosted-email-setup.md for Gmail setup instructions.
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=your.email@gmail.com
# IMAP_PASSWORD=your-gmail-app-password
# IMAP_FOLDER=INBOX
# IMAP_POLL_INTERVAL=60

# AWS Lambda end-to-end test (dev/e2e/test_lambda_e2e.py)
# Only needed if you're running the AWS Lambda stack and want to exercise the
# live S3 → Lambda → DynamoDB path. Skip this block for the self-hosted IMAP path.
# E2E_EMAIL_BUCKET=your-s3-email-bucket
# E2E_USER_ID=your-user-id            # becomes the BudgetConfig partition key USER#<id>
# E2E_LAMBDA_FUNCTION=email-parser    # optional; default email-parser
# E2E_TRANSACTIONS_TABLE=Transactions # optional; default Transactions
# E2E_BUDGET_TABLE=BudgetConfig       # optional; default BudgetConfig
